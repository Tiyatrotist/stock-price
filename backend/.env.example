# Backend server port. Defaults to 5000 when unset.
PORT=5000

# Cache duration in seconds. Defaults to 60.
CACHE_DURATION=60

# Minimum delay between external API requests in seconds. Defaults to 2.0.
MIN_REQUEST_DELAY=2.0

# Optional Finnhub API key for live US market data.
FINNHUB_API_KEY=

# Optional Upstox API key used by the Indian market integration.
UPSTOX_API_KEY=

# Upstox OAuth application credentials. Leave empty when Upstox is not used.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# OAuth callback URL. Defaults to http://localhost:3000.
UPSTOX_REDIRECT_URI=http://localhost:3000

# Legacy token migration fallback. Runtime tokens are stored in
# backend/_cache/upstox_tokens.json after they are loaded/refreshed.
UPSTOX_ACCESS_TOKEN=
UPSTOX_REFRESH_TOKEN=

# Optional ISO-8601 expiry timestamp for a legacy access token.
UPSTOX_TOKEN_EXPIRY=
